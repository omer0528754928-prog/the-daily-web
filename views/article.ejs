<%
  // These always come from the controller (see controllers/articleController.js).
  // comments is the newest page only; commentCount is the total, for the heading.
  const { article, related, comments, commentCount, commentLimits } = locals;
  // After a comment that did not pass validation: what the guest typed, and what to fix
  const commentForm = locals.commentForm || {};
  const commentErrors = locals.commentErrors || [];
  // Sample data until the weather widget (Member 2) is connected
  const weather = locals.weather || { city: 'תל אביב', temp: '27°' };
%>
<%- include('partials/head', { title: article.title }) %>
<%- include('partials/header') %>

<main class="container container--narrow page">
  <div class="article-layout">
    <article class="card article">
      <nav class="breadcrumb" aria-label="מיקום באתר">
        <a href="/">ראשי</a> /
        <a href="/?category=<%= encodeURIComponent(article.category) %>"><%= article.category %></a>
      </nav>
      <h1 class="article__title"><%= article.title %></h1>
      <% if (article.summary) { %>
        <p class="article__summary"><%= article.summary %></p>
      <% } %>
      <div class="byline">
        <span class="avatar"></span>
        <strong><%= article.reporter %></strong>
        <span>· <time datetime="<%= article.publishedAt %>"><%= article.date %></time></span>
        <span class="byline__views"><%= article.views %> צפיות</span>
      </div>
      <% if (article.image) { %>
        <img src="<%= article.image %>" alt="<%= article.title %>" class="article__img">
      <% } else { %>
        <div class="img-placeholder article__img"><span>תמונה ראשית · קרדיט צילום</span></div>
      <% } %>
      <div class="article__body">
        <% article.paragraphs.forEach(paragraph => { %>
          <p><%= paragraph %></p>
        <% }) %>
      </div>

      <section class="comments" id="comments">
        <h2>תגובות (<%= commentCount %>)</h2>
        <form action="/articles/<%= article.id %>/comments" method="post" class="comment-form">
          <div class="comment-form__row">
            <input type="text" name="name" placeholder="שם (אורח)" maxlength="<%= commentLimits.authorName %>" value="<%= commentForm.name || '' %>">
            <span class="hint">עד 3 תגובות בדקה מאותו מכשיר</span>
          </div>
          <textarea name="text" placeholder="כתבו תגובה…" maxlength="<%= commentLimits.text %>" required><%= commentForm.text || '' %></textarea>
          <div class="comment-form__row">
            <button type="submit" class="btn btn-primary">פרסום תגובה</button>
            <% if (locals.rateLimited) { %>
              <span class="alert alert-error">חרגת מהמגבלה — נסו שוב בעוד דקה</span>
            <% } %>
            <% commentErrors.forEach(message => { %>
              <span class="alert alert-error" role="alert"><%= message %></span>
            <% }) %>
          </div>
        </form>
        <% if (comments.length) { %>
          <div class="comment-list">
            <% comments.forEach(comment => { %>
              <article class="comment">
                <span class="avatar"></span>
                <div>
                  <div class="comment__head">
                    <strong><%= comment.name %></strong>
                    <time class="meta" datetime="<%= comment.createdAt %>"><%= comment.time %></time>
                  </div>
                  <p><%= comment.text %></p>
                </div>
              </article>
            <% }) %>
          </div>
          <% if (commentCount > comments.length) { %>
            <p class="hint">מוצגות <%= comments.length %> התגובות האחרונות מתוך <%= commentCount %></p>
          <% } %>
        <% } else { %>
          <p class="hint">עדיין אין תגובות לכתבה הזו. אפשר להיות הראשונים להגיב.</p>
        <% } %>
      </section>
    </article>

    <aside class="sidebar">
      <section class="widget weather weather--compact">
        <div class="weather__main">
          <div>
            <div class="weather__city">מזג אוויר · <%= weather.city %></div>
            <div class="weather__temp"><%= weather.temp %></div>
          </div>
          <div class="weather__sun"></div>
        </div>
      </section>

      <section class="widget">
        <h3 class="widget__title">כתבות נוספות בקטגוריה</h3>
        <% if (related.length) { %>
          <ul class="related">
            <% related.forEach(item => { %>
              <li>
                <a href="/articles/<%= item.id %>"><%= item.title %></a>
                <span class="meta"><time datetime="<%= item.publishedAt %>"><%= item.date %></time> · <%= item.reporter %></span>
              </li>
            <% }) %>
          </ul>
        <% } else { %>
          <p class="hint">אין כרגע כתבות נוספות בקטגוריה הזו.</p>
        <% } %>
      </section>
    </aside>
  </div>
</main>

<%- include('partials/footer') %>
