<%- include('partials/head', { title: 'התחברות' }) %>
<%- include('partials/header') %>

<main class="container container--narrow page page--login">
  <div class="login-card">
    <div class="login-card__hero">
      <svg class="login-card__lines" viewBox="0 0 400 400" preserveAspectRatio="none" aria-hidden="true">
        <g fill="none" stroke="#fff" stroke-width="1.2">
          <path d="M320 -40 C 250 90, 250 250, 330 400"></path>
          <path d="M355 -40 C 285 90, 285 250, 365 400"></path>
          <path d="M390 -40 C 320 90, 320 250, 400 400"></path>
          <path d="M285 -40 C 215 90, 215 250, 295 400"></path>
        </g>
      </svg>
      <div class="login-card__intro">
        <svg width="44" height="44" viewBox="0 0 48 48" role="img" aria-label="The Daily Web">
          <rect x="10" y="11" width="28" height="4" rx="2" fill="#fff"></rect>
          <rect x="10" y="20" width="16" height="17" rx="2" fill="#fff"></rect>
          <rect x="29" y="20" width="9" height="4" rx="2" fill="#fff" opacity="0.7"></rect>
          <rect x="29" y="27" width="9" height="4" rx="2" fill="#fff" opacity="0.7"></rect>
          <rect x="29" y="34" width="9" height="3" rx="1.5" fill="#fff" opacity="0.5"></rect>
        </svg>
        <h2>שלום,<br>צוות The Daily Web</h2>
        <p>אזור הכתבים והעורכים — כתיבה, הגשה לאישור ופרסום. אורחים יכולים לקרוא ולהגיב בלי התחברות.</p>
      </div>
    </div>

    <form action="/login" method="post" class="login-card__form">
      <div>
        <h3>ברוכים הבאים</h3>
        <p class="hint">אין לכם חשבון? פנו לעורך המערכת לקבלת הרשאות.</p>
      </div>
      <% if (locals.error) { %>
        <div class="alert alert-error"><%= locals.error %></div>
      <% } %>
      <label class="line-field">שם משתמש
        <input type="text" name="username" placeholder="reporter01" autocomplete="username" required>
      </label>
      <label class="line-field">סיסמה
        <input type="password" name="password" placeholder="••••••••" autocomplete="current-password" required>
      </label>
      <button type="submit" class="btn btn-dark btn-lg">כניסה למערכת</button>
      <p class="hint">שכחתם סיסמה? פנו לעורך המערכת.</p>
    </form>
  </div>
</main>

<%- include('partials/footer') %>
