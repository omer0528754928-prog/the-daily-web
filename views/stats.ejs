<%
  // Real data from statsController:
  //   picker   = [{ key, label }]  every published article the editor can inspect
  //   selected = { key, label, views:[counts], labels:[per bucket], updates:[bucket indices] } | null
  //   kpis     = [{ label, value, delta }]
  const picker = locals.picker || [];
  const selected = locals.selected || null;
  const kpis = locals.kpis || [];
  const views = selected ? selected.views : [];
  const labels = selected ? selected.labels : [];
  const hasData = views.length > 0;

  // Chart drawing area inside the 760×300 SVG
  const left = 46, right = 748, top = 24, bottom = 256;
  const peak = hasData ? Math.max(...views) : 0;
  const maxValue = Math.max(peak * 1.1, 1);
  const xFor = (index) => (views.length > 1 ? left + (index * (right - left)) / (views.length - 1) : left);
  const yFor = (value) => bottom - (value / maxValue) * (bottom - top);
  const linePoints = views.map((value, index) => `${xFor(index).toFixed(1)},${yFor(value).toFixed(1)}`).join(' ');
  const gridLines = [0, 1, 2, 3, 4].map(step => {
    const value = (maxValue / 4) * (4 - step);
    return { y: yFor(value).toFixed(1), label: Math.round(value).toLocaleString('en-US') };
  });
%>
<%- include('partials/head', { title: 'סטטיסטיקות' }) %>
<%- include('partials/header', { active: 'stats' }) %>

<main class="container container--narrow page">
  <div class="page-head">
    <div class="page-head__text">
      <h1>Impact Analytics</h1>
      <p>צפיות לאורך זמן, עם סימון נקודות פרסום עדכון</p>
    </div>
    <a href="/editor" class="btn btn-outline">→ חזרה לאזור העורך</a>
  </div>

  <% if (locals.connectedUsers !== null && typeof locals.connectedUsers !== 'undefined') { %>
    <div class="kpis">
      <div class="card kpi">
        <span class="kpi__label">משתמשים מחוברים כעת</span>
        <span class="kpi__value"><%= connectedUsers %></span>
        <span class="kpi__delta">נתון חי מכלל האתר</span>
      </div>
    </div>
  <% } %>

  <% if (!picker.length) { %>
    <section class="card panel">
      <p class="empty">עדיין אין כתבות שפורסמו, ולכן אין נתוני צפיות להצגה.</p>
    </section>
  <% } else { %>
    <%# Article filter: a native <details> dropdown. The menu shows about 10 articles and
        then scrolls, so a long list stays compact. Each option is a link, so it also works
        without JavaScript. %>
    <details class="stats-picker">
      <summary class="stats-picker__summary">
        <span class="stats-picker__current">בחירת כתבה: <strong><%= selected ? selected.label : '—' %></strong></span>
        <span class="stats-picker__caret" aria-hidden="true">▾</span>
      </summary>
      <div class="stats-picker__menu" role="listbox">
        <% picker.forEach(item => { %>
          <a href="/stats?article=<%= item.key %>" class="stats-picker__item <%= selected && selected.key === item.key ? 'is-active' : '' %>"><%= item.label %></a>
        <% }) %>
      </div>
    </details>

    <div class="kpis">
      <% kpis.forEach(kpi => { %>
        <div class="card kpi">
          <span class="kpi__label"><%= kpi.label %></span>
          <span class="kpi__value"><%= kpi.value %></span>
          <% if (kpi.delta) { %><span class="kpi__delta"><%= kpi.delta %></span><% } %>
        </div>
      <% }) %>
    </div>

    <section class="card panel">
      <div class="chart-head">
        <h2 class="panel__title">צפיות לאורך זמן · <%= selected ? selected.label : '' %></h2>
        <span class="legend"><span class="legend__line"></span>צפיות</span>
        <span class="legend"><span class="legend__marker"></span>פרסום עדכון</span>
      </div>

      <% if (!hasData) { %>
        <p class="empty">אין עדיין נתוני צפיות לכתבה הזו. צפיות נספרות בכל כניסה לדף הכתבה.</p>
      <% } else { %>
        <div class="chart-wrap">
          <svg viewBox="0 0 760 300" class="chart" role="img" aria-label="צפיות לאורך זמן">
            <rect x="0" y="0" width="760" height="300" class="chart__bg"></rect>
            <% gridLines.forEach(line => { %>
              <line x1="<%= left %>" y1="<%= line.y %>" x2="<%= right %>" y2="<%= line.y %>" class="chart__grid"></line>
              <text x="40" y="<%= Number(line.y) + 4 %>" text-anchor="end" class="chart__text"><%= line.label %></text>
            <% }) %>
            <% selected.updates.forEach((index, number) => { %>
              <line x1="<%= xFor(index).toFixed(1) %>" y1="20" x2="<%= xFor(index).toFixed(1) %>" y2="<%= bottom %>" class="chart__marker"></line>
              <text x="<%= (xFor(index) + 6).toFixed(1) %>" y="16" class="chart__text chart__text--marker">עדכון <%= number + 1 %> פורסם</text>
            <% }) %>
            <polyline points="<%= left %>,<%= bottom %> <%= linePoints %> <%= right %>,<%= bottom %>" class="chart__area"></polyline>
            <polyline points="<%= linePoints %>" class="chart__line"></polyline>
            <% views.forEach((value, index) => { %>
              <circle cx="<%= xFor(index).toFixed(1) %>" cy="<%= yFor(value).toFixed(1) %>" r="3.5" class="chart__dot"></circle>
              <% if (index % 3 === 0 || index === views.length - 1) { %>
                <text x="<%= xFor(index).toFixed(1) %>" y="278" text-anchor="<%= index === views.length - 1 ? 'end' : 'middle' %>" class="chart__text"><%= labels[index] %></text>
              <% } %>
            <% }) %>
          </svg>
        </div>
        <p class="chart-insight">הקו מראה את כמות הצפיות בכל נקודת זמן. הקווים האנכיים מסמנים מתי העורך אישר ופרסם עדכון, כך שאפשר לראות איך השתנו הצפיות לפני ואחרי כל עדכון.</p>
      <% } %>
    </section>
  <% } %>
</main>

<%- include('partials/footer') %>
