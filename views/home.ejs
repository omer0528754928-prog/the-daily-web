<%
  const articles = locals.articles || [];
  const ticker = locals.ticker || [
    'בנק ישראל: הריבית נותרה ללא שינוי',
    'המועצה אישרה את תוכנית התחבורה הרב־שנתית',
    'פסטיבל הקולנוע נפתח הערב עם שלושה בכורות',
    'עדכון: שינויים בקווי האוטובוס מיום ראשון',
  ];
  const popular = locals.popular || articles.slice(0, 5);
  const weather = locals.weather || null;
  const forecast = locals.forecast || null;
  const hasMore = locals.hasMore ?? false;

  const query = locals.query || {};
  const sort = query.sort || 'date';
  const view = query.view || 'all';
  const sorts = [{ value: 'date', label: 'תאריך' }, { value: 'popular', label: 'פופולריות' }];
  const views = [{ value: 'all', label: 'הכל' }, { value: 'unseen', label: 'לא נצפו' }, { value: 'seen', label: 'נצפו' }];
  // Builds a feed link that keeps the current filters and changes only the given ones
  const feedLink = (changes) => {
    const params = new URLSearchParams({ ...query, ...changes });
    return `/?${params}`;
  };

  const lead = articles[0];
  const sideStories = articles.slice(1, 4);
  const moreStories = articles.slice(4);
%>
<%- include('partials/head', { title: 'פיד הבית' }) %>
<%- include('partials/header', { active: 'feed' }) %>
<script src="/js/feed.js" defer></script>
<script src="/js/weather.js" defer></script>
<main class="container page">
  <div class="ticker">
    <span class="ticker__label">מבזקים</span>
    <div class="ticker__window">
      <div class="ticker__track">
        <% [...ticker, ...ticker].forEach(item => { %>
          <span class="ticker__item"><%= item %></span>
        <% }) %>
      </div>
    </div>
  </div>

  <div class="filters">
    <form action="/" method="get" class="filters__group">
      <label class="filters__label" for="category-select">קטגוריה</label>
      <select id="category-select" name="category">
        <option value="">הכל</option>
        <% categories.forEach(category => { %>
          <option value="<%= category %>" <%= query.category === category ? 'selected' : '' %>><%= category %></option>
        <% }) %>
      </select>
      <input type="hidden" name="sort" value="<%= sort %>">
      <input type="hidden" name="view" value="<%= view %>">
      <% if (query.q) { %>
        <input type="hidden" name="q" value="<%= query.q %>">
      <% } %>
      <button type="submit" class="btn btn-outline btn-sm">סינון</button>
    </form>
    <div class="filters__group">
      <span class="filters__label">מיון</span>
      <% sorts.forEach(option => { %>
        <a href="<%= feedLink({ sort: option.value }) %>" class="pill <%= sort === option.value ? 'is-active' : '' %>"><%= option.label %></a>
      <% }) %>
    </div>
    <div class="filters__group">
      <span class="filters__label">תצוגה</span>
      <% views.forEach(option => { %>
        <a href="<%= feedLink({ view: option.value }) %>" class="pill <%= view === option.value ? 'is-active' : '' %>"><%= option.label %></a>
      <% }) %>
    </div>
    <% if (query.q) { %>
      <span class="filters__count">תוצאות עבור "<%= query.q %>"</span>
    <% } %>
  </div>

  <div class="with-sidebar">
    <div class="feed">
      <% if (lead) { %>
        <div class="top-stories">
          <a href="/articles/<%= lead.id %>" class="card lead" data-id="<%= lead.id %>">
            <div class="img-placeholder lead__img"><span>תמונה ראשית</span></div>
            <div class="lead__body">
              <div class="meta">
                <span class="tag"><%= lead.category %></span>
                <span><%= lead.reporter %> · <%= lead.date %></span>
              </div>
              <h2 class="lead__title"><%= lead.title %></h2>
              <p class="lead__summary"><%= lead.summary %></p>
            </div>
          </a>

          <div class="side-stories">
            <% sideStories.forEach(article => { %>
              <a href="/articles/<%= article.id %>" class="card side-card" data-id="<%= article.id %>">
                <div class="img-placeholder side-card__img"></div>
                <div class="side-card__body">
                  <span class="category-label"><%= article.category %></span>
                  <h3><%= article.title %></h3>
                  <span class="meta"><%= article.date %> · <%= article.reporter %></span>
                </div>
              </a>
            <% }) %>
          </div>
        </div>
      <% } else { %>
        <p class="empty">לא נמצאו כתבות.</p>
      <% } %>

      <section>
        <div class="section-title" <%= moreStories.length ? '' : 'hidden' %>>
          <h2>עוד בחדשות</h2>
          <span></span>
        </div>
        <div class="card-grid" id="feed-grid">
          <% moreStories.forEach(article => { %>
            <a href="/articles/<%= article.id %>" class="card grid-card" data-id="<%= article.id %>">
              <div class="img-placeholder grid-card__img"><span>תמונת כתבה</span></div>
              <div class="grid-card__body">
                <div class="meta">
                  <span class="tag tag-soft"><%= article.category %></span>
                  <span><%= article.date %></span>
                </div>
                <h3><%= article.title %></h3>
                <p><%= article.summary %></p>
                <div class="grid-card__footer">
                  <span><%= article.reporter %></span>
                  <span>· <%= article.views %> צפיות</span>
                </div>
              </div>
            </a>
          <% }) %>
        </div>
        <%# An empty grid card for feed.js to clone and fill (must match the cards above) %>
        <template id="grid-card-template">
          <a class="card grid-card">
            <div class="img-placeholder grid-card__img"><span>תמונת כתבה</span></div>
            <div class="grid-card__body">
              <div class="meta">
                <span class="tag tag-soft" data-field="category"></span>
                <span data-field="date"></span>
              </div>
              <h3 data-field="title"></h3>
              <p data-field="summary"></p>
              <div class="grid-card__footer">
                <span data-field="reporter"></span>
                <span>· <span data-field="views"></span> צפיות</span>
              </div>
            </div>
          </a>
        </template>
      </section>
      <div class="refresh-sentinel" data-has-more="<%= hasMore %>" data-next-skip="<%= articles.length %>"></div>
      <div class="feed-error" hidden>
        <span>לא הצלחנו לטעון כתבות נוספות.</span>
        <button type="button" class="btn btn-outline btn-sm retry-button">נסה שוב</button>
      </div>
      <p class="feed-end" <%= (hasMore || !articles.length) ? 'hidden' : '' %>>זהו, ראית הכל ✓</p>
    </div>

    <aside class="sidebar">
      <%- include('partials/weatherWidgetBig', { weather, forecast }) %>
      <section class="widget">
        <h3 class="widget__title">הנצפות ביותר</h3>
        <ol class="popular">
          <% popular.forEach((article, index) => { %>
            <li>
              <span class="popular__rank"><%= index + 1 %></span>
              <a href="/articles/<%= article.id %>">
                <span class="popular__title"><%= article.title %></span>
                <span class="meta"><%= article.views %> צפיות</span>
              </a>
            </li>
          <% }) %>
        </ol>
      </section>

      <section class="widget widget--tinted">
        <h3 class="widget__title">הניוזלטר היומי</h3>
        <p class="widget__text">תקציר הכתבות החשובות, פעם ביום, בבוקר.</p>
        <form action="/newsletter" method="post" class="newsletter">
          <input type="email" name="email" placeholder="כתובת אימייל" required>
          <button type="submit" class="btn btn-primary btn-sm">הרשמה</button>
        </form>
      </section>
    </aside>
  </div>
</main>

<%- include('partials/footer') %>
