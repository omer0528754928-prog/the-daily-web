<%
  const queue = locals.queue || [];
  const tabs = locals.tabs || [];
  const activeStatus = locals.activeStatus || '';
  const pager = locals.pager || { page: 1, total: queue.length, pageSize: queue.length || 1 };
  const totalPages = Math.max(1, Math.ceil(pager.total / pager.pageSize));
  const activeLabel = (tabs.find(t => t.key === activeStatus) || { label: 'הכל' }).label;
  const statusHref = (key) => (key ? `/editor?status=${encodeURIComponent(key)}` : '/editor');
%>
<%- include('partials/head', { title: 'אזור העורך' }) %>
<%- include('partials/header', { active: 'editor' }) %>

<main class="container container--narrow page">
  <% if (locals.flash) { %>
    <div class="alert alert-success"><%= flash %></div>
  <% } %>

  <div class="page-head">
    <div class="page-head__text">
      <h1>אזור העורך</h1>
      <p><%= pager.total %> כתבות · מסונן לפי «<%= activeLabel %>»</p>
    </div>
    <nav class="tabs">
      <% tabs.forEach(tab => { %>
        <a href="<%= statusHref(tab.key) %>" class="pill <%= activeStatus === tab.key ? 'is-active' : '' %>"><%= tab.label %></a>
      <% }) %>
    </nav>
  </div>

  <div class="queue">
    <% queue.forEach(article => { %>
      <div class="card queue-item">
        <div class="queue-item__info">
          <strong class="queue-item__title"><%= article.title %></strong>
          <span class="meta"><%= article.reporter %> · <%= article.category %> · הוגש <%= article.updated %></span>
          <span class="meta">מוצג לציבור: <%= article.live %> · ממתין לאישור: <%= article.pending %></span>
        </div>
        <span class="status" data-status="<%= article.status %>"><%= article.status %></span>
        <div class="actions">
          <a href="/editor/articles/<%= article.id %>/review" class="btn btn-primary btn-sm">בדיקה ואישור</a>
          <form action="/editor/articles/<%= article.id %>/delete" method="post" onsubmit="return confirm('למחוק את הכתבה «<%= article.title.replace(/'/g, "\\'") %>»? פעולה זו אינה הפיכה.');">
            <button type="submit" class="btn btn-danger btn-sm">מחיקה</button>
          </form>
        </div>
      </div>
    <% }) %>
    <% if (!queue.length) { %>
      <p class="empty">אין כתבות בסטטוס הזה.</p>
    <% } %>
  </div>

  <% if (totalPages > 1) { %>
    <% const base = activeStatus ? `status=${encodeURIComponent(activeStatus)}&` : ''; %>
    <nav class="pager" aria-label="ניווט בין עמודים">
      <% if (pager.page > 1) { %>
        <a href="/editor?<%= base %>page=<%= pager.page - 1 %>" class="btn btn-outline btn-sm pager__step">הקודם <span aria-hidden="true">→</span></a>
      <% } else { %>
        <span class="btn btn-outline btn-sm pager__step is-disabled">הקודם <span aria-hidden="true">→</span></span>
      <% } %>
      <span class="pager__info">עמוד <%= pager.page %> מתוך <%= totalPages %></span>
      <% if (pager.page < totalPages) { %>
        <a href="/editor?<%= base %>page=<%= pager.page + 1 %>" class="btn btn-outline btn-sm pager__step"><span aria-hidden="true">←</span> הבא</a>
      <% } else { %>
        <span class="btn btn-outline btn-sm pager__step is-disabled"><span aria-hidden="true">←</span> הבא</span>
      <% } %>
    </nav>
  <% } %>
</main>

<%- include('partials/footer') %>
