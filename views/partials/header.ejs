<%
  const active = locals.active || '';
  const query = locals.query || {};
  const currentCategory = query.category || 'הכל';
  const today = new Date().toLocaleDateString('he-IL', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });
  const navLinks = [
    { key: 'feed', href: '/', label: 'פיד הבית' },
    { key: 'reporter', href: '/reporter', label: 'אזור כתב' },
    { key: 'editor', href: '/editor', label: 'אזור עורך' },
    { key: 'stats', href: '/stats', label: 'סטטיסטיקות' },
  ];
%>
<div class="topbar">
  <a href="/" class="topbar__brand">
    <svg width="38" height="38" viewBox="0 0 48 48" role="img" aria-label="The Daily Web">
      <rect x="0" y="0" width="48" height="48" rx="10" fill="#fff"></rect>
      <rect x="10" y="11" width="28" height="4" rx="2" fill="var(--primary)"></rect>
      <rect x="10" y="20" width="16" height="17" rx="2" fill="var(--primary)"></rect>
      <rect x="29" y="20" width="9" height="4" rx="2" fill="var(--primary)" opacity="0.62"></rect>
      <rect x="29" y="27" width="9" height="4" rx="2" fill="var(--primary)" opacity="0.62"></rect>
      <rect x="29" y="34" width="9" height="3" rx="1.5" fill="var(--primary)" opacity="0.42"></rect>
    </svg>
    <span class="topbar__name">The Daily Web</span>
  </a>
  <span class="topbar__sep"></span>
  <span class="topbar__date"><%= today %></span>
  <nav class="topbar__nav">
    <% navLinks.forEach(link => { %>
      <a href="<%= link.href %>" class="topbar__link <%= active === link.key ? 'is-active' : '' %>"><%= link.label %></a>
    <% }) %>
  </nav>
  <a href="/login" class="topbar__login">התחברות</a>
</div>

<header class="site-header">
  <div class="container site-header__inner">
    <nav class="cat-nav">
      <a href="/" class="cat-nav__link <%= currentCategory === 'הכל' ? 'is-active' : '' %>">הכל</a>
      <% categories.forEach(category => { %>
        <a href="/?category=<%= encodeURIComponent(category) %>" class="cat-nav__link <%= currentCategory === category ? 'is-active' : '' %>"><%= category %></a>
      <% }) %>
    </nav>
    <form action="/" method="get" class="search">
      <input type="search" name="q" value="<%= query.q || '' %>" placeholder="חיפוש כתבות…">
      <button type="submit" aria-label="חיפוש">
        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round">
          <circle cx="10.5" cy="10.5" r="6.5"></circle>
          <line x1="15.4" y1="15.4" x2="20.5" y2="20.5"></line>
        </svg>
      </button>
    </form>
  </div>
</header>
