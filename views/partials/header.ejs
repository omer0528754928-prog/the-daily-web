<%
  const active = locals.active || '';
  const query = locals.query || {};
  const currentCategory = query.category || 'הכל';
  const today = new Date().toLocaleDateString('he-IL', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });
  const navLinks = [
    { key: 'feed', href: '/', label: 'פיד הבית' },
    { key: 'reporter', href: '/reporter', label: 'אזור כתב' },
    { key: 'editor', href: '/editor', label: 'אזור עורך' },
    { key: 'stats', href: '/stats', label: 'סטטיסטיקות' },
  ];
  // Category link that keeps the search and sort when used on the home page (so it works without JS too).
  // Other pages' query strings mean something else (e.g. the reporter's table filters), so they aren't carried over.
  const categoryLink = (category) => {
    const params = new URLSearchParams();
    if (category) params.set('category', category);
    if (active === 'feed') {
      if (query.q) params.set('q', query.q);
      if (query.sort) params.set('sort', query.sort);
    }
    return params.toString() ? `/?${params}` : '/';
  };
%>
<div class="topbar">
  <a href="/" class="topbar__brand">
    <svg width="38" height="38" viewBox="0 0 48 48" role="img" aria-label="The Daily Web">
      <rect x="0" y="0" width="48" height="48" rx="10" fill="#fff"></rect>
      <rect x="10" y="11" width="28" height="4" rx="2" fill="var(--primary)"></rect>
      <rect x="10" y="20" width="16" height="17" rx="2" fill="var(--primary)"></rect>
      <rect x="29" y="20" width="9" height="4" rx="2" fill="var(--primary)" opacity="0.62"></rect>
      <rect x="29" y="27" width="9" height="4" rx="2" fill="var(--primary)" opacity="0.62"></rect>
      <rect x="29" y="34" width="9" height="3" rx="1.5" fill="var(--primary)" opacity="0.42"></rect>
    </svg>
    <span class="topbar__name">The Daily Web</span>
  </a>
  <span class="topbar__sep"></span>
  <span class="topbar__date"><%= today %></span>
  <nav class="topbar__nav">
    <% navLinks.forEach(link => { %>
      <a href="<%= link.href %>" class="topbar__link <%= active === link.key ? 'is-active' : '' %>"><%= link.label %></a>
    <% }) %>
  </nav>
  <% if (locals.currentUser) { %>
    <div class="topbar__account">
      <span>שלום, <%= currentUser.name %></span>
      <button type="button" class="topbar__login" onclick="document.getElementById('logout-dialog').showModal()">התנתקות</button>
    </div>
    <dialog id="logout-dialog" class="logout-dialog" dir="rtl" aria-labelledby="logout-question">
      <p id="logout-question">האם אתה בטוח שברצונך להתנתק?</p>
      <div class="logout-dialog__actions">
        <form method="dialog">
          <button type="submit" class="btn btn-outline" autofocus>לא</button>
        </form>
        <form action="/logout" method="POST">
          <button type="submit" class="btn btn-primary">כן</button>
        </form>
      </div>
    </dialog>
    <script>
      setInterval(async () => {
        if (document.visibilityState !== 'visible') return;
        try {
          const response = await fetch('/session/keep-alive', { method: 'POST' });
          if (response.status === 401) window.location.href = '/login';
        } catch {
          // A temporary network failure can wait until the next interval.
        }
      }, 4 * 60 * 1000);
    </script>
  <% } else { %>
    <a href="/login" class="topbar__login">התחברות</a>
  <% } %>
</div>

<header class="site-header">
  <div class="container site-header__inner">
    <nav class="cat-nav">
      <a href="<%= categoryLink('') %>" class="cat-nav__link <%= currentCategory === 'הכל' ? 'is-active' : '' %>" data-category="">הכל</a>
      <% categories.forEach(category => { %>
        <a href="<%= categoryLink(category) %>" class="cat-nav__link <%= currentCategory === category ? 'is-active' : '' %>" data-category="<%= category %>"><%= category %></a>
      <% }) %>
    </nav>
    <form action="/" method="get" class="search">
      <input type="search" name="q" value="<%= query.q || '' %>" maxlength="100" placeholder="חיפוש כתבות…">
      <button type="submit" aria-label="חיפוש">
        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round">
          <circle cx="10.5" cy="10.5" r="6.5"></circle>
          <line x1="15.4" y1="15.4" x2="20.5" y2="20.5"></line>
        </svg>
      </button>
    </form>
  </div>
</header>
